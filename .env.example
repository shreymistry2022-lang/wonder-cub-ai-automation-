# Automation System Configuration
NODE_ENV=development
PORT=3000

# Feature Flags & Safety Controls
AUTOMATION_ENABLED=true
PUBLISH_ENABLED=false
OUTREACH_ENABLED=false
SPEND_ENABLED=false

# Meta / Instagram Graph API (Phase 2)
META_APP_ID=your_meta_app_id
META_APP_SECRET=your_meta_app_secret
META_ACCESS_TOKEN=your_meta_access_token
INSTAGRAM_ACCOUNT_ID=your_instagram_account_id

# Website & Analytics Integrations
WEBSITE_BASE_URL=https://thewondercub.store
GA4_PROPERTY_ID=your_ga4_property_id
META_PIXEL_ID=your_meta_pixel_id

# Database Configuration
DATABASE_URL=sqlite://data/thewondercub.db
# For PostgreSQL in production: postgresql://user:password@localhost:5432/thewondercub

# LLM / AI Configuration (if executing via external API key)
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
